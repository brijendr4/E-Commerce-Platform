# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# === DATABASE ===
# Local MongoDB (no auth):
MONGODB_URI=mongodb://localhost:27017/ecommerce
# With auth (Docker or Atlas):
# MONGODB_URI=mongodb://USER:PASSWORD@host:27017/ecommerce?authSource=admin
# MongoDB Atlas cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# === AUTHENTICATION ===
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_128_char_hex_string
JWT_EXPIRES_IN=7d

# === SERVER ===
PORT=5000
NODE_ENV=development

# === CORS ===
# Your frontend URL (no trailing slash)
FRONTEND_URL=http://localhost:5173

# === REDIS ===
# Local: redis://127.0.0.1:6379
# With password: redis://:REDIS_PASSWORD@host:6379
REDIS_URL=redis://127.0.0.1:6379

# === EMAIL (OTP Service) ===
# If not set, OTP codes are printed to the backend console log
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-gmail-app-password  (use Gmail App Password, not your real password)

# === DOCKER COMPOSE ONLY ===
# Only needed when running services via docker-compose
# MONGO_USER=ecommerceuser
# MONGO_PASSWORD=generate_strong_password_here
# REDIS_PASSWORD=generate_strong_password_here
